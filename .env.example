# Copy to .env and fill in. Nothing here is a real credential.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velora"

# Signing key for session tokens. Generate one with: npx auth secret
AUTH_SECRET="replace-me-with-a-generated-secret"

# Public origin of the deployment. Used to build links in outgoing email.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Auth.js infers a trusted host in development but not when serving a
# production build. Set AUTH_URL to the public origin, or set
# AUTH_TRUST_HOST=true when running behind a proxy that sets the host header.
# Without one of these, every /api/auth request fails with UntrustedHost.
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# Outbound email (Resend). Without this, verification and reminder emails are
# skipped with a console warning rather than failing -- which means nobody can
# verify an address, so it is effectively required once signups are open.
RESEND_API_KEY=""

# The From address on outgoing mail. Resend refuses to send from a domain the
# account has not verified, so this must be a domain you control.
EMAIL_FROM="Velora <noreply@velora.app>"

# Protects /api/cron/reminders, which is invoked by the schedule in
# vercel.json. The route refuses every request when this is unset, so the
# reminder job silently does nothing until you set it.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Strongly recommended in production
# ---------------------------------------------------------------------------

# Shared store for rate limiting (login, signup, password reset). Without it
# the limiter falls back to an in-memory counter that is per-instance and
# resets on cold start, so limits will not hold across a serverless
# deployment. Any Upstash-compatible Redis REST endpoint works.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Login requires a verified email address unless this is exactly "false".
# Accounts created before this was introduced have no verification timestamp
# and would be refused, so run `npm run db:verify-existing` once against an
# existing database before leaving this enabled.
# REQUIRE_EMAIL_VERIFICATION="false"

# ---------------------------------------------------------------------------
# Public demo deployments
# ---------------------------------------------------------------------------
#
# A demo has no mail provider, so signups cannot verify an address. Set
# REQUIRE_EMAIL_VERIFICATION="false" and seed a ready-made account instead:
#
#   npm run db:seed-demo
#
# The credentials below are what that script creates and what visitors sign in
# with, so DEMO_PASSWORD is public by design -- never reuse a real password.
# Re-running the script resets the demo board, which makes it easy to schedule
# a periodic reset.
# DEMO_EMAIL="demo@velora.app"
# DEMO_PASSWORD="velorademo123"
