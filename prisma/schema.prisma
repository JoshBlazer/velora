// Velora Database Schema
// A creative workflow platform for visual artists

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum BoardRole {
  OWNER
  EDITOR
  VIEWER
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_MOVED
  TASK_ASSIGNED
  COLUMN_CREATED
  COLUMN_DELETED
  COLUMN_RENAMED
  BOARD_RENAMED
  MEMBER_ADDED
  MEMBER_REMOVED
  COMMENT_ADDED
}

// ============================================
// MODELS
// ============================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Hashed password for credentials auth
  name          String?
  image         String?   // Avatar URL
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  boards        Board[]
  boardMembers  BoardMember[]
  activities    Activity[]
  comments      Comment[]
  assignedTasks Task[]        @relation("TaskAssignee")
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Board {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  background String?  // Gradient hex or image URL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns    Column[]
  labels     Label[]
  members    BoardMember[]
  activities Activity[]

  @@index([userId])
  @@map("boards")
}

model BoardMember {
  id        String    @id @default(uuid()) @db.Uuid
  boardId   String    @db.Uuid
  userId    String    @db.Uuid
  role      BoardRole @default(EDITOR)
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@map("board_members")
}

model Column {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  order     Int      // Position on the board (for drag-and-drop ordering)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  boardId String @db.Uuid
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([boardId])
  @@map("columns")
}

model Task {
  id              String    @id @default(uuid()) @db.Uuid
  content         String
  priority        Priority  @default(MEDIUM)
  dueDate         DateTime? // Optional due date
  reminderSentAt  DateTime? // Set after sending the due-date reminder email
  order           Int       // Position within the column (for drag-and-drop ordering)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  columnId   String  @db.Uuid
  column     Column  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  labels     Label[] // Many-to-many with labels
  comments   Comment[]
  assigneeId String?  @db.Uuid
  assignee   User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([columnId])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("comments")
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  color     String   // Hex color code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  boardId String @db.Uuid
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[] // Many-to-many with tasks

  @@index([boardId])
  @@map("labels")
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  boardId   String       @db.Uuid
  userId    String       @db.Uuid
  type      ActivityType
  meta      Json         @default("{}")
  createdAt DateTime     @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt(sort: Desc)])
  @@map("activities")
}
